generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model urls {
  id           Int       @id @default(autoincrement())
  original_url String
  alias        String    @unique @db.VarChar(255)
  clicks       Int       @default(0)
  created_at   DateTime? @default(now()) @db.Timestamp(6)
}

model User {
  id                   String              @id @default(cuid())
  email                String              @unique
  passwordHash         String?
  name                 String?
  role                 String              @default("USER")
  googleId             String?             @unique
  subscriptionPlan     String              @default("TRIAL_30D") // TRIAL_30D, PLAN_90D, PLAN_180D, PLAN_365D, LIFETIME, EXPIRED
  subscriptionExpiresAt DateTime?
  isLifetime           Boolean             @default(false)
  sessionVersion       Int                 @default(1)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  frames               Frame[]
  subscriptionOrders   SubscriptionOrder[]
}

model SubscriptionOrder {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planKey      String   // plan_90d, plan_180d, plan_365d, plan_lifetime
  planDays     Int      // 90, 180, 365, 99999
  planTitle    String   // Gói 90 Ngày, Gói 180 Ngày,...
  amount       Int      // Số tiền VNĐ
  transferCode String   @unique // GH_XXXXXX
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Frame {
  id        String   @id @default(cuid())
  userId    String
  title     String
  slug      String   @unique
  imageUrl  String
  views     Int      @default(0)
  downloads Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String
  type      String   // "REGISTER" | "RESET_PASSWORD" | "GOOGLE_REGISTER"
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Visit {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QaRoom {
  id          String       @id @default(cuid())
  code        String       @unique // e.g. "839201"
  title       String       // e.g. "Thảo luận Bài 5: Khám dấu hiệu sinh tồn"
  subject     String?      // e.g. "Điều dưỡng cơ bản"
  teacherName String?      // e.g. "Thầy Luyến"
  isOpen      Boolean      @default(true) // Cho phép đặt câu hỏi hay tạm khóa
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  questions   QaQuestion[]
}

model QaQuestion {
  id          String   @id @default(cuid())
  roomId      String
  room        QaRoom   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  content     String
  authorAlias String   @default("Ẩn danh")
  category    String   @default("Thắc mắc chung") // #Lý_thuyết, #Thực_hành, #Thi_cử, #Góp_ý
  upvotes     Int      @default(0)
  isAnswered  Boolean  @default(false)
  isPinned    Boolean  @default(false)
  answerNote  String?  // Ghi chú câu trả lời của giảng viên nếu có
  createdAt   DateTime @default(now())
}

model QuizPackage {
  id          String   @id @db.VarChar(64)
  userId      String?  @db.VarChar(64)
  title       String   @db.VarChar(255)
  subject     String?  @db.VarChar(255)
  description String?
  code        String?  @unique @db.VarChar(32)
  isOpen      Boolean? @default(true)
  questions   Json     @default("[]")
  settings    Json     @default("{}")
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @default(now())
}

model QuizSubmission {
  id               String   @id @db.VarChar(64)
  quizId           String   @db.VarChar(64)
  quizTitle        String?  @db.VarChar(255)
  studentName      String   @db.VarChar(255)
  studentId        String   @db.VarChar(100)
  className        String?  @db.VarChar(100)
  email            String?  @db.VarChar(255)
  score            Decimal? @default(0) @db.Decimal(5, 2)
  totalPoints      Decimal? @default(0) @db.Decimal(5, 2)
  percentage       Decimal? @default(0) @db.Decimal(5, 2)
  passed           Boolean? @default(false)
  timeSpentSeconds Int?     @default(0)
  answers          Json?    @default("{}")
  violationCount   Int?     @default(0)
  status           String?  @default("GRADED") @db.VarChar(32)
  hasManualGrading Boolean? @default(false)
  manualScores     Json?    @default("{}")
  teacherFeedback  String?  @db.Text
  examQuestions    Json?    @default("[]")
  submittedAt      DateTime? @default(now())
}

model SyllabusSubject {
  id             String    @id @db.VarChar(64)
  userId         String    @db.VarChar(64)
  name           String    @db.VarChar(255)
  schoolName     String?   @db.VarChar(255)
  departmentName String?   @db.VarChar(255)
  sourceType     String?   @db.VarChar(32)
  sourceTitle    String?   @db.VarChar(255)
  rawContent     String?   @db.Text
  driveFileId    String?   @db.VarChar(255)
  driveUrl       String?   @db.Text
  tree           Json      @default("[]")
  createdAt      DateTime? @default(now())
  updatedAt      DateTime? @default(now())
}

model AttendanceSession {
  id               String             @id @default(cuid())
  userId           String             // Giảng viên tạo buổi điểm danh
  title            String             // Tên môn học hoặc chủ đề: ví dụ "Điều dưỡng cơ bản - Buổi 3"
  className        String?            // Lớp học: ví dụ "DƯỢC-K18"
  code             String             @unique // Mã PIN 6 chữ số: ví dụ "739182"
  secretKey        String             // Secret key để sinh dynamic QR token
  isOpen           Boolean            @default(true)
  requireGps       Boolean            @default(false)
  latitude         Float?
  longitude        Float?
  maxDistanceMeters Int?              @default(100)
  refreshSeconds   Int                @default(8) // Chu kỳ đổi mã QR (mặc định 8s)
  allowMultiplePerDevice Boolean      @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  records          AttendanceRecord[]
}

model AttendanceRecord {
  id         String            @id @default(cuid())
  sessionId  String
  session    AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentName String           // Họ và tên sinh viên
  studentId  String            // Mã số sinh viên
  className  String?           // Lớp
  email      String?
  deviceHash String?           // Hash thiết bị / browser fingerprint chống điểm danh hộ
  latitude   Float?
  longitude  Float?
  distanceMeters Float?
  status     String            @default("PRESENT") // PRESENT, LATE, EXCUSED
  note       String?
  checkedInAt DateTime         @default(now())

  @@unique([sessionId, studentId]) // 1 sinh viên chỉ điểm danh 1 lần trong 1 buổi
}

// ==========================================
// MODULE 2: BẢNG VINH DANH & TÍCH ĐIỂM HỌC TẬP
// ==========================================

model LeaderboardGroup {
  id          String         @id @default(cuid())
  userId      String         // Giảng viên quản lý nhóm
  name        String         // Tên lớp / Nhóm thi đua (Ví dụ: Dược K18 - Học kỳ 1)
  className   String?        // Tên lớp học
  description String?
  theme       String?        @default("default") // theme giao diện vinh danh
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  students    StudentScore[]
}

model StudentScore {
  id           String             @id @default(cuid())
  groupId      String
  group        LeaderboardGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentName  String             // Họ và tên học viên
  studentId    String             // Mã số sinh viên
  className    String?            // Lớp
  avatar       String?            // URL avatar hoặc emoji hoạt hình
  totalPoints  Int                @default(0) // Tổng điểm tích lũy
  level        Int                @default(1) // Cấp độ (1, 2, 3...)
  streak       Int                @default(0) // Chuỗi tích cực
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  transactions PointTransaction[]
  badges       StudentBadge[]

  @@unique([groupId, studentId]) // Mỗi SV duy nhất trong 1 nhóm
}

model PointTransaction {
  id             String       @id @default(cuid())
  studentScoreId String
  studentScore   StudentScore @relation(fields: [studentScoreId], references: [id], onDelete: Cascade)
  points         Int          // Số điểm (+1, +2, +5, -1...)
  reason         String       // Lý do cộng/trừ điểm (Phát biểu, Làm bài tốt...)
  createdAt      DateTime     @default(now())
}

model Badge {
  id          String         @id @default(cuid())
  code        String         @unique // speech_master, speed_demon, full_attendance, top_performer
  name        String         // Tên danh hiệu (Chiến thần phát biểu, Bách phát bách trúng...)
  description String
  icon        String         // Emoji hoặc icon name
  minPoints   Int            @default(0) // Mốc điểm mở khóa tự động (nếu có)
  students    StudentBadge[]
}

model StudentBadge {
  id             String       @id @default(cuid())
  studentScoreId String
  studentScore   StudentScore @relation(fields: [studentScoreId], references: [id], onDelete: Cascade)
  badgeId        String
  badge          Badge        @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedAt      DateTime     @default(now())

  @@unique([studentScoreId, badgeId])
}

// ==========================================
// MODULE 3: ĐẤU TRƯỜNG ĐỐ VUI TRỰC TIẾP (LIVE QUIZ BATTLE)
// ==========================================

model LiveBattleRoom {
  id               String             @id @default(cuid())
  userId           String             // Giảng viên tạo phòng
  pinCode          String             @unique // Mã PIN 6 chữ số: ví dụ "839102"
  title            String             // Tiêu đề phòng thi: ví dụ "Đấu trường Dược lý K18 - Vòng 1"
  status           String             @default("LOBBY") // LOBBY, QUESTION, LEADERBOARD, FINISHED
  currentQuestionIndex Int            @default(0) // Câu hỏi hiện tại (0-indexed)
  timePerQuestion  Int                @default(20) // Thời gian mỗi câu (giây)
  questionStartedAt DateTime?         // Thời điểm bắt đầu câu hỏi hiện tại
  questions        Json               @default("[]") // Danh sách câu hỏi trắc nghiệm
  settings         Json               @default("{}") // Cấu hình âm thanh, điểm thưởng, vinh danh
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  players          LiveBattlePlayer[]
}

model LiveBattlePlayer {
  id               String             @id @default(cuid())
  roomId           String
  room             LiveBattleRoom     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  nickname         String             // Tên hiển thị của sinh viên
  studentId        String?            // Mã số sinh viên
  className        String?            // Lớp học
  avatarEmoji      String             @default("🦊") // Emoji đại diện
  teamId           String?            // ID Đội (ví dụ 'red', 'blue', 'yellow', 'green', 'purple', 'orange')
  teamName         String?            // Tên Đội (ví dụ 'Team Đỏ 🔴', 'Team Xanh 🔵')
  totalScore       Int                @default(0) // Tổng điểm tích lũy
  streak           Int                @default(0) // Chuỗi câu trả lời đúng liên tiếp
  isOnline         Boolean            @default(true)
  joinedAt         DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  answers          LiveBattleAnswer[]

  @@unique([roomId, nickname])
}

model LiveBattleAnswer {
  id               String             @id @default(cuid())
  playerId         String
  player           LiveBattlePlayer   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  questionIndex    Int                // Thứ tự câu hỏi
  selectedOption   Int                // 0 (A), 1 (B), 2 (C), 3 (D)
  isCorrect        Boolean            @default(false)
  timeSpentMs      Int                @default(0) // Thời gian bấm phản hồi (ms)
  scoreAwarded     Int                @default(0) // Điểm nhận được
  answeredAt       DateTime           @default(now())

  @@unique([playerId, questionIndex])
}

// ==========================================
// MODULE 4: HỎI ĐÁP TÀI LIỆU PDF BẰNG AI (CHAT WITH PDF)
// ==========================================

model PdfChatSession {
  id               String             @id @default(cuid())
  userId           String?            // Người dùng (nếu có đăng nhập)
  fileName         String             // Tên file gốc
  fileSize         Int                @default(0)
  pageCount        Int                @default(0)
  summary          String?            @db.Text // Tóm tắt do AI tạo
  extractedText    String?            @db.Text // Nội dung text đã trích xuất từ PDF
  messages         Json               @default("[]") // Lịch sử đoạn chat [{role, content, timestamp, citations}]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}
