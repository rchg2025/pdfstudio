generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model urls {
  id           Int       @id @default(autoincrement())
  original_url String
  alias        String    @unique @db.VarChar(255)
  clicks       Int       @default(0)
  created_at   DateTime? @default(now()) @db.Timestamp(6)
}

model User {
  id                   String              @id @default(cuid())
  email                String              @unique
  passwordHash         String?
  name                 String?
  role                 String              @default("USER")
  googleId             String?             @unique
  subscriptionPlan     String              @default("TRIAL_30D") // TRIAL_30D, PLAN_90D, PLAN_180D, PLAN_365D, LIFETIME, EXPIRED
  subscriptionExpiresAt DateTime?
  isLifetime           Boolean             @default(false)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  frames               Frame[]
  subscriptionOrders   SubscriptionOrder[]
}

model SubscriptionOrder {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planKey      String   // plan_90d, plan_180d, plan_365d, plan_lifetime
  planDays     Int      // 90, 180, 365, 99999
  planTitle    String   // Gói 90 Ngày, Gói 180 Ngày,...
  amount       Int      // Số tiền VNĐ
  transferCode String   @unique // GH_XXXXXX
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Frame {
  id        String   @id @default(cuid())
  userId    String
  title     String
  slug      String   @unique
  imageUrl  String
  views     Int      @default(0)
  downloads Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String
  type      String   // "REGISTER" | "RESET_PASSWORD" | "GOOGLE_REGISTER"
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Visit {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QaRoom {
  id          String       @id @default(cuid())
  code        String       @unique // e.g. "839201"
  title       String       // e.g. "Thảo luận Bài 5: Khám dấu hiệu sinh tồn"
  subject     String?      // e.g. "Điều dưỡng cơ bản"
  teacherName String?      // e.g. "Thầy Luyến"
  isOpen      Boolean      @default(true) // Cho phép đặt câu hỏi hay tạm khóa
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  questions   QaQuestion[]
}

model QaQuestion {
  id          String   @id @default(cuid())
  roomId      String
  room        QaRoom   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  content     String
  authorAlias String   @default("Ẩn danh")
  category    String   @default("Thắc mắc chung") // #Lý_thuyết, #Thực_hành, #Thi_cử, #Góp_ý
  upvotes     Int      @default(0)
  isAnswered  Boolean  @default(false)
  isPinned    Boolean  @default(false)
  answerNote  String?  // Ghi chú câu trả lời của giảng viên nếu có
  createdAt   DateTime @default(now())
}

model QuizPackage {
  id          String   @id @db.VarChar(64)
  userId      String?  @db.VarChar(64)
  title       String   @db.VarChar(255)
  subject     String?  @db.VarChar(255)
  description String?
  code        String?  @unique @db.VarChar(32)
  isOpen      Boolean? @default(true)
  questions   Json     @default("[]")
  settings    Json     @default("{}")
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @default(now())
}

model QuizSubmission {
  id               String   @id @db.VarChar(64)
  quizId           String   @db.VarChar(64)
  quizTitle        String?  @db.VarChar(255)
  studentName      String   @db.VarChar(255)
  studentId        String   @db.VarChar(100)
  className        String?  @db.VarChar(100)
  email            String?  @db.VarChar(255)
  score            Decimal? @default(0) @db.Decimal(5, 2)
  totalPoints      Decimal? @default(0) @db.Decimal(5, 2)
  percentage       Decimal? @default(0) @db.Decimal(5, 2)
  passed           Boolean? @default(false)
  timeSpentSeconds Int?     @default(0)
  answers          Json?    @default("{}")
  submittedAt      DateTime? @default(now())
}
